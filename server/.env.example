# TEMPLATE ONLY. Fill with your own application registration; no shared access.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET_FILE=/opt/drivetalk/secrets/tesla-client-secret
TESLA_DOMAIN=console.example.invalid
TESLA_REDIRECT_URI=https://console.example.invalid/oauth/callback
# Public supplier endpoints: choose the region documented for YOUR account.
TESLA_AUTH_BASE=https://auth.tesla.cn/oauth2/v3
TESLA_FLEET_API_BASE=https://fleet-api.prd.cn.vn.cloud.tesla.cn
TESLA_SCOPES="openid offline_access vehicle_device_data vehicle_location vehicle_cmds"
TESLA_VEHICLE_VIN=

DRIVETALK_BIND_HOST=127.0.0.1
DRIVETALK_BIND_PORT=8788
DRIVETALK_DB_PATH=/var/lib/drivetalk/state.sqlite3
DRIVETALK_TOKEN_KEY_FILE=/opt/drivetalk/secrets/token-encryption.key
DRIVETALK_MOBILE_TOKEN_FILE=/opt/drivetalk/secrets/mobile-api-token
# Optional rights-cleared model; not shipped or loaded by default.
DRIVETALK_MODEL_FILE=/opt/drivetalk/assets/vehicle.glb

# Closed until an operator separately configures a trusted signing gateway.
DRIVETALK_COMMANDS_ENABLED=false
DRIVETALK_SIGNING_PROXY_URL=
DRIVETALK_SIGNING_PROXY_CA_FILE=
DRIVETALK_TRUNK_CLOSE_ENABLED=false
SMARTHOME_CONTROL_ENABLED=0
SMARTHOME_CREDENTIAL_DIR=
LOG_LEVEL=INFO
