# Safe public defaults: purely synthetic local data, no control credentials.
VITE_DATA_MODE=mock
VITE_VEHICLE_BACKEND_PATH=/v1/vehicle
VITE_VEHICLE_COMMAND_PROXY_URL=/v1/vehicle
# Use your own authorized AMap web key, or leave blank to show coordinates only.
VITE_AMAP_JS_KEY=
# 3D visualization is original procedural geometry and needs no model download.
